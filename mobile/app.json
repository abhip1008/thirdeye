{
  "expo": {
    "name": "Third Eye",
    "slug": "thirdeye",
    "scheme": "thirdeye",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "dev.thirdeye.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.thirdeye.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Third Eye connects to the vest on its own Wi-Fi network to fetch clips. It does not use the internet during a match.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "192.168.43.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            }
          },
          "NSAllowsLocalNetworking": true
        },
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Third Eye uses the camera once, to scan the pairing code on the vest. It never records video on the phone.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacy": {
        "dataCollected": "none, unless the umpire opts into signing in",
        "analytics": "none",
        "networkPeers": "the paired vest on its own access point",
        "identity": "optional Auth0 sign-in; an email address, held in the keystore, never sent to the vest"
      },
      "auth0": {
        "domain": "dev-umxcdh2y62l4e0gy.us.auth0.com",
        "clientId": "qsLzof7a3MLc8KC0QWxvD9AaEdEicwaT"
      }
    }
  }
}
