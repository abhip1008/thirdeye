{
  "name": "thirdeye-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.20",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.87.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^30.5.1",
    "jest-expo": "^57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "babel-preset-expo",
              {
                "jsxRuntime": "automatic"
              }
            ]
          ]
        }
      ]
    },
    "moduleNameMapper": {
      "\\.(mp4|mov|png|jpg|jpeg|gif|webp|svg|ttf|otf)$": "<rootDir>/test/assetStub.js",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/test/setup.js"
    ]
  }
}
