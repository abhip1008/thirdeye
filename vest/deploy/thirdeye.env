# Copy to /etc/thirdeye.env and edit for the unit.

THIRDEYE_CAMERA_ID=vest-01

# The camera. One of:
#   libcamera:0          a camera on the Pi's ribbon connector
#   camera:/dev/video0   a USB camera
# Run scripts/check-hardware.sh on the board to find out which you have.
THIRDEYE_SOURCE=libcamera:0

# Leave unset for software encoding. Set it only if check-hardware.sh finds a
# hardware encoder - h264_v4l2m2m on a Pi 4, nothing on a Pi 5.
# THIRDEYE_ENCODER=h264_v4l2m2m

# What to ask the camera for. These must be a mode the sensor really has -
# check-hardware.sh prints the list, or run `rpicam-hello --list-cameras`.
# The prototype's OV5647 does 1920x1080 at 30. The production AR0234 does
# 1920x1200 at 60.
THIRDEYE_WIDTH=1920
THIRDEYE_HEIGHT=1080
THIRDEYE_FRAMERATE=30

# The address the pairing code tells the phone to dial. The vest's own AP hands
# out 192.168.43.1; a Raspberry Pi hotspot made with nmcli is 10.42.0.1; a vest
# on a home network during development is whatever DHCP gave it. Get this wrong
# and the QR code scans perfectly and points the phone at nothing.
THIRDEYE_ADVERTISE_HOST=192.168.43.1

THIRDEYE_BUFFER_SECONDS=300
THIRDEYE_PREROLL_SECONDS=5
THIRDEYE_CLIP_TIMEOUT_SECONDS=40
THIRDEYE_RING_SIZE=12
THIRDEYE_VIDEO_BITRATE=5M

THIRDEYE_DATA_ROOT=/data/matches
THIRDEYE_BUFFER_DIR=/data/buffer

# Request signing. Leave this alone: with it off, any phone that joins the
# vest's Wi-Fi can list and download footage of people, and the passphrase for
# that Wi-Fi is printed on the vest. The only reason the switch exists is
# development, and the vest logs a line in capitals when it is used.
# THIRDEYE_REQUIRE_SIGNATURE=false

# Minted on first boot, mode 0600, never served over the API. Print the pairing
# code the phone scans with:  python -m thirdeye.pairing
THIRDEYE_KEY_PATH=/data/signing.key
