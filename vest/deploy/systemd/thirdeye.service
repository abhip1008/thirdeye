[Unit]
Description=Third Eye vest

# Ordering only, and deliberately not network-online.target.
#
# `Wants=network-online.target` pulls in NetworkManager-wait-online, which waits
# for connectivity - and a vest has none by design: its access point has no
# uplink and never will. On a headless unit that is up to a minute of systemd
# waiting for the internet before the camera is allowed to start, which is a
# minute of cricket that was never recorded, at the one moment nobody can log in
# and find out why.
#
# Nothing here needs the network to come up. The recorder wants a camera and a
# disk; uvicorn binds the wildcard address whether or not an interface exists
# yet, and starts answering the moment the radio appears.
After=network.target

[Service]
Type=simple
User=thirdeye
WorkingDirectory=/opt/thirdeye/vest
EnvironmentFile=/etc/thirdeye.env
# 0.0.0.0, not 127.0.0.1. The phone is on the other side of the vest's own
# access point, so a service bound to loopback is a vest that answers nothing
# and looks, from the phone, exactly like a vest that is switched off. Nothing
# else routes to this network: the AP has no path to the internet, and every
# request that reveals anything is signed.
ExecStart=/opt/thirdeye/vest/.venv/bin/uvicorn thirdeye.main:app --host 0.0.0.0 --port 8000

# It has to come back. This runs unattended, in the rain, on a battery, and the
# difference between a restart and a lost innings is this line.
Restart=always
RestartSec=2

# And it has to keep coming back. By default systemd gives up after five starts
# in ten seconds and stays down - which with RestartSec=2 is reached in exactly
# ten seconds of any failure loop. A vest that gives up permanently because the
# camera took a moment too long at boot is worse than one that retries forever
# while somebody walks over to look at it.
StartLimitIntervalSec=0

# The recorder is the one thing that must not be starved. A vest that boots
# into a busy first minute still has to be capturing during it.
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2

# It writes video and nothing else.
ProtectSystem=strict
ReadWritePaths=/data
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
